ANTHROPIC_API_KEY=your_key_here

# Fallback chain — used only if Claude itself fails (outage, rate limit, credit
# exhausted). The app works fine with just ANTHROPIC_API_KEY set; each fallback below
# is optional and only makes the tool more resilient, not less required.
DEEPSEEK_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here
